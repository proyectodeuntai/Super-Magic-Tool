rules_version = '2';

// ═══════════════════════════════════════════════════════════
// Magic Toolbox — Reglas de seguridad de Firestore
// ═══════════════════════════════════════════════════════════
// Modelo simple para un grupo cerrado de amigos:
//  - Cualquier usuario autenticado puede LEER los datos de todos.
//  - Cada usuario solo puede ESCRIBIR sus propios documentos.
//  - El flag isAdmin no puede cambiarse desde el cliente (evita
//    que un jugador se auto-promocione a administrador).
//  - Los nombres de jugador son únicos de forma atómica vía
//    usernames/{nameLower} (la clave ES el documento).
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true;
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create: if isSelf(playerId)
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin()
        || (isSelf(playerId) && request.resource.data.get('isAdmin', false) == false);
      allow delete: if isAdmin() || isSelf(playerId);
    }

    match /usernames/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && exists(/databases/$(database)/documents/usernames/$(name))
        && get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid;
    }

    match /collections/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if isSelf(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if isSelf(userId) || isAdmin();
    }
  }
}
